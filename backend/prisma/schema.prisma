generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────────
// Authentication & Authorization
// ───────────────────────────────────────────────────────────────

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id        Int       @id @default(autoincrement())
  fullName  String
  email     String    @unique
  password  String
  phone     String?
  roleId    Int
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  role                Role                 @relation(fields: [roleId], references: [id])
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  // One-to-One Employee Profile
  employee Employee?

  @@index([roleId])
  @@index([email])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// Single-use password reset tokens. Only the SHA-256 digest is stored.
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Uploaded files (profile photos), kept in the database so they survive
// redeploys on hosts with a temporary disk. The id is the public file name:
// /uploads/profiles/<id>.
model StoredFile {
  id        String   @id
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

// ───────────────────────────────────────────────────────────────
// Workforce
// ───────────────────────────────────────────────────────────────

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  code        String    @unique
  description String?
  managerId   Int?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employees Employee[]

  @@index([code])
  @@index([isActive])
  @@index([deletedAt])
}

model Shift {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  startTime    String
  endTime      String
  isNightShift Boolean  @default(false)
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employees Employee[]
}

model Employee {
  id Int @id @default(autoincrement())

  // Identity
  employeeCode String  @unique
  firstName    String
  lastName     String
  email        String? @unique
  phone        String?
  gender       Gender?

  dateOfBirth DateTime?
  joiningDate DateTime

  // Employment
  designation    String
  employmentType EmploymentType @default(FULL_TIME)
  salary         Decimal?       @db.Decimal(10, 2)

  // Department
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Shift
  shiftId Int?
  shift   Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  // Reporting Manager
  managerId Int?
  manager   Employee? @relation("EmployeeManager", fields: [managerId], references: [id])

  subordinates Employee[] @relation("EmployeeManager")

  // ERP Login
  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Status
  status EmployeeStatus @default(ACTIVE)

  profileImage String?

  // Address
  address String?
  city    String?
  state   String?
  country String?
  pincode String?

  // Emergency Contact
  emergencyName  String?
  emergencyPhone String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  attendances       Attendance[]
  attendancePunches AttendancePunch[]

  @@index([employeeCode])
  @@index([email])
  @@index([departmentId])
  @@index([managerId])
  @@index([shiftId])
  @@index([status])
}

model Attendance {
  id Int @id @default(autoincrement())

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date DateTime

  clockIn  DateTime?
  clockOut DateTime?

  workingHours Float?

  status AttendanceStatus

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
}

model AttendancePunch {
  id Int @id @default(autoincrement())

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  sourceSystem       String @default("ESSL")
  deviceId           String
  externalEmployeeId String
  externalEventId    String

  occurredAt DateTime                 @db.Timestamptz(3)
  direction  AttendancePunchDirection

  processingStatus AttendancePunchStatus @default(RECEIVED)
  processedAt      DateTime?             @db.Timestamptz(3)
  processingError  String?

  rawPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceSystem, deviceId, externalEventId])
  @@index([employeeId])
  @@index([occurredAt])
  @@index([employeeId, occurredAt])
  @@index([externalEventId])
}

// ───────────────────────────────────────────────────────────────
// Inventory
// ───────────────────────────────────────────────────────────────

model Material {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  code        String  @unique
  description String?
  unit        String
  category    String?
  location    String?

  currentStock  Decimal  @default(0) @db.Decimal(12, 3)
  minStockLevel Decimal  @default(0) @db.Decimal(12, 3)
  maxStockLevel Decimal? @db.Decimal(12, 3)

  costPerUnit Decimal? @db.Decimal(12, 2)
  currency    String   @default("INR")

  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  transactions StockTransaction[]
  scrapRecords ScrapRecord[]

  @@index([code])
  @@index([isActive])
  @@index([category])
  @@index([currentStock])
}

model StockTransaction {
  id         Int      @id @default(autoincrement())
  materialId Int
  material   Material @relation(fields: [materialId], references: [id])

  type         StockTransactionType
  quantity     Decimal              @db.Decimal(12, 3)
  balanceAfter Decimal              @db.Decimal(12, 3)

  referenceNo     String?
  reason          String?
  performedById   Int?
  performedByName String?
  departmentId    Int?
  departmentName  String?

  createdAt DateTime @default(now())

  @@index([materialId])
  @@index([type])
  @@index([createdAt])
  @@index([departmentId])
  @@index([referenceNo])
}

model ScrapRecord {
  id         Int      @id @default(autoincrement())
  materialId Int
  material   Material @relation(fields: [materialId], references: [id])

  quantity       Decimal  @db.Decimal(12, 3)
  unit           String
  departmentId   Int?
  departmentName String?
  employeeId     Int?
  employeeName   String?
  reason         String?
  recoveryValue  Decimal? @db.Decimal(12, 2)

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([materialId])
  @@index([departmentId])
  @@index([recordedAt])
}

// ───────────────────────────────────────────────────────────────
// Orders
// ───────────────────────────────────────────────────────────────

model Supplier {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  code         String    @unique
  contactName  String?
  email        String?
  phone        String?
  address      String?
  city         String?
  state        String?
  country      String    @default("India")
  gstin        String?
  rating       Decimal?  @db.Decimal(3, 1) // 0.0 – 5.0
  leadTimeDays Int?
  reliability  String? // "98%", "99%" etc.
  materials    String? // comma-separated material names
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([code])
  @@index([isActive])
}

model Client {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  code        String    @unique
  contactName String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String    @default("India")
  gstin       String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  clientOrders ClientOrder[]

  @@index([code])
  @@index([isActive])
}

model ClientOrder {
  id          Int    @id @default(autoincrement())
  orderNumber String @unique // e.g. ORD-2841
  clientId    Int
  client      Client @relation(fields: [clientId], references: [id])

  product  String
  quantity Int
  unit     String   @default("pcs")
  value    Decimal? @db.Decimal(14, 2)
  currency String   @default("INR")

  orderDate    DateTime  @default(now())
  requiredDate DateTime?
  dispatchDate DateTime?
  deliveryDate DateTime?

  status ClientOrderStatus @default(PENDING)

  notes         String?
  dispatchNote  String?
  challanNumber String?
  invoiceNumber String?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([orderDate])
  @@index([orderNumber])
}

model PurchaseOrder {
  id         Int      @id @default(autoincrement())
  poNumber   String   @unique // e.g. PO-2847
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  material  String
  quantity  String // e.g. "500 kg"
  unit      String?
  totalCost Decimal? @db.Decimal(14, 2)
  currency  String   @default("INR")

  orderDate        DateTime  @default(now())
  expectedDelivery DateTime?
  actualDelivery   DateTime?

  status PurchaseOrderStatus @default(PENDING)

  notes       String?
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@index([poNumber])
}

// ───────────────────────────────────────────────────────────────
// Production
// ───────────────────────────────────────────────────────────────

model WorkOrder {
  id              Int    @id @default(autoincrement())
  workOrderNumber String @unique // e.g. WO-0042

  // What to produce
  product        String
  targetQuantity Decimal @db.Decimal(12, 3)
  unit           String  @default("pcs")

  // Scheduling
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?

  // Tracking
  status   WorkOrderStatus   @default(DRAFT)
  priority WorkOrderPriority @default(NORMAL)

  // Links
  departmentId   Int?
  departmentName String?
  assignedToId   Int? // Employee (supervisor)
  assignedToName String?
  clientOrderId  Int? // Optional link to a ClientOrder

  notes String?

  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  outputs WorkOrderOutput[]

  @@index([status])
  @@index([priority])
  @@index([departmentId])
  @@index([scheduledStart])
  @@index([clientOrderId])
}

model WorkOrderOutput {
  id          Int       @id @default(autoincrement())
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  // Quantities
  goodQty     Decimal @db.Decimal(12, 3) // accepted output
  rejectedQty Decimal @default(0) @db.Decimal(12, 3)
  scrapQty    Decimal @default(0) @db.Decimal(12, 3)

  recordedAt DateTime @default(now())

  // Who recorded it
  recordedById   Int?
  recordedByName String?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workOrderId])
  @@index([recordedAt])
}

// ───────────────────────────────────────────────────────────────
// ───────────────────────────────────────────────────────────────
// Security
// ───────────────────────────────────────────────────────────────

model SecurityIncident {
  id             Int    @id @default(autoincrement())
  incidentNumber String @unique // e.g. INC-0001

  title       String
  description String
  aiSummary   String?
  type        IncidentType
  confidenceScore Float?
  severity    IncidentSeverity @default(MEDIUM)
  status      IncidentStatus   @default(OPEN)

  // Location / scope
  location       String?
  departmentId   Int?
  departmentName String?

  // People
  reportedById   Int?
  reportedByName String?
  assignedToId   Int?
  assignedToName String?

  // Timing
  occurredAt DateTime  @default(now())
  resolvedAt DateTime?
  closedAt   DateTime?

  // Investigation
  rootCause        String?
  correctiveAction String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  updates IncidentUpdate[]
  alerts  SecurityAlert[]

  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([departmentId])
  @@index([occurredAt])
}

model IncidentUpdate {
  id         Int              @id @default(autoincrement())
  incidentId Int
  incident   SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  comment      String
  statusChange IncidentStatus? // null means no status change, just a comment

  updatedById   Int?
  updatedByName String?

  createdAt DateTime @default(now())

  @@index([incidentId])
  @@index([createdAt])
}

model SecurityAlert {
  id          Int    @id @default(autoincrement())
  alertNumber String @unique // e.g. ALT-0001

  title    String
  message  String
  type     AlertType
  severity IncidentSeverity @default(MEDIUM)
  status   AlertStatus      @default(ACTIVE)

  // Source
  source         String? // e.g. "CCTV", "Manual", "Sensor"
  location       String?
  departmentId   Int?
  departmentName String?

  // Link to incident (optional)
  incidentId Int?
  incident   SecurityIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  // Acknowledgement
  acknowledgedById   Int?
  acknowledgedByName String?
  acknowledgedAt     DateTime?

  // Resolution
  resolvedById   Int?
  resolvedByName String?
  resolvedAt     DateTime?

  expiresAt DateTime? // auto-expire time for time-bound alerts

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([departmentId])
  @@index([incidentId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────
// Audit Log
// ───────────────────────────────────────────────────────────────
model AuditLog {
  id Int @id @default(autoincrement())

  // Who
  userId    Int?
  userEmail String?
  userRole  String?

  // What
  action     AuditAction
  entity     String // e.g. "Employee", "WorkOrder"
  entityId   String? // string to handle any PK type
  entityCode String? // human-readable ref (e.g. EMP-001)

  // Request metadata
  method     String? // HTTP method
  path       String? // URL path
  statusCode Int?

  // Diff snapshot (optional — only for write operations)
  before Json?
  after  Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────
// ENUMS
// ───────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  LEAVE
}

enum StockTransactionType {
  IN // Stock received / purchased
  OUT // Consumed in production
  ADJUSTMENT // Manual correction
  SCRAP // Scrap write-off
  RETURN // Returned to supplier / store
}

enum ClientOrderStatus {
  PENDING
  APPROVED
  IN_PRODUCTION
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PurchaseOrderStatus {
  PENDING
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  EXPORT
  STATUS_CHANGE
  BULK_ACTION
}

enum WorkOrderStatus {
  DRAFT // Created but not yet released
  RELEASED // Released to production floor
  IN_PROGRESS // Production has started
  ON_HOLD // Paused
  COMPLETED // Production finished
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum IncidentType {
  FIRE
  FIRE_SMOKE
  SMOKE
  CROWD
  FIGHT
  FALL
  INTRUSION
  LOITERING
  THEFT
  INJURY
  PROPERTY_DAMAGE
  UNAUTHORIZED_ACCESS
  EQUIPMENT_FAILURE
  CHEMICAL_SPILL
  NEAR_MISS
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum AlertType {
  SAFETY
  SECURITY
  MAINTENANCE
  FIRE
  INTRUSION
  ENVIRONMENTAL
  CUSTOM
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  EXPIRED
}

enum AttendancePunchDirection {
  IN
  OUT
}

enum AttendancePunchStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}
