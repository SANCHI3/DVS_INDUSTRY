# ─────────────────────────────────────────────────────────────────
# DVS Industry — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # development | test | production

# ── Database ──────────────────────────────────────────────────────
# Create a dedicated low-privilege DB user — never use the postgres superuser.
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
# Privileged connection used only by Prisma migrations; never use it at runtime.
DIRECT_URL=postgresql://<MIGRATION_USER>:<MIGRATION_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# ── JWT Access Token ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<replace-with-64-byte-hex-secret>
JWT_EXPIRES_IN=15m

# ── JWT Refresh Token ─────────────────────────────────────────────
# Use a DIFFERENT secret from JWT_SECRET
REFRESH_TOKEN_SECRET=<replace-with-different-64-byte-hex-secret>
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Security ──────────────────────────────────────────────────────
# Bcrypt cost factor — 12 is a good default (increase only if hardware permits)
BCRYPT_SALT_ROUNDS=12

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Reverse proxy ─────────────────────────────────────────────────
# Number of trusted proxy hops in front of the API. Set to 1 behind nginx so
# rate limiting and audit logs see real client IPs (0 = no proxy).
TRUST_PROXY=0

# ── Frontend URL (used in password-reset emails) ──────────────────
APP_URL=http://localhost:5173

# ── Outgoing mail (password reset) ────────────────────────────────
# Leave SMTP_HOST empty in development: reset links are then logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=DVS Industries <no-reply@dvsindustry.com>
# Inbox that receives website contact-form inquiries (needs SMTP_HOST).
INQUIRY_NOTIFY_EMAIL=

# ── Logging ───────────────────────────────────────────────────────
# error | warn | info | http | debug
LOG_LEVEL=info

# ── Seed (optional — only used by: npm run db:seed) ──────────────────────────
# If not set, defaults shown below are used. Change before seeding production!
SEED_ADMIN_EMAIL=admin@dvsindustry.com
SEED_ADMIN_PASSWORD=<generate-a-unique-password-at-least-16-characters>

# ── Perception service account (optional — used by npm run db:seed) ──────────
# Creates a PERCEPTION_SERVICE user that the CCTV perception service logs in
# as. Put the same credentials in perception-service/.env as
# DASHBOARD_SERVICE_EMAIL / DASHBOARD_SERVICE_PASSWORD.
SEED_PERCEPTION_SERVICE_EMAIL=
SEED_PERCEPTION_SERVICE_PASSWORD=

# ── Demo logins for the other portals (optional, development only) ──────────
# Each account is created by npm run db:seed only when SEED_TEST_DATA=true and
# its password is set; the seed never creates them when NODE_ENV=production.
# Leave SEED_TEST_DATA unset when seeding the live (Neon) database.
SEED_TEST_DATA=
SEED_PRODUCTION_EMAIL=production.test@dvsindustry.local
SEED_PRODUCTION_PASSWORD=
SEED_STORE_EMAIL=store.test@dvsindustry.local
SEED_STORE_PASSWORD=
SEED_SUPPLIER_EMAIL=supplier.test@dvsindustry.local
SEED_SUPPLIER_PASSWORD=
SEED_CLIENT_EMAIL=client.test@dvsindustry.local
SEED_CLIENT_PASSWORD=

# ── Rate limiting ───────────────────────────────────────────────────────────
# Requests per 15 minutes per IP for the API (the live incident stream is
# exempt). The browser and the camera service share an IP on one machine.
RATE_LIMIT_MAX=500

# Key the CCTV PC uses instead of an account (at least 32 characters).
CAMERA_SERVICE_KEY=

# ── Perception service files shown on the dashboard (optional) ──────────────
# Paths are relative to backend/. PERCEPTION_OUTPUT_DIR holds the incident
# evidence written by the CCTV service (keyframes, Grad-CAM, clips, AI
# explanation).
PERCEPTION_OUTPUT_DIR=../perception-service/output

# ── "Ask DVS" assistant (optional) ──────────────────────────────────────────
# Any OpenAI-compatible chat-completions API with tool calling. Defaults to
# Groq (free key at https://console.groq.com). Leave the key empty to turn the
# assistant off: its panel then shows "Assistant not configured".
ASSISTANT_LLM_BASE_URL=https://api.groq.com/openai/v1
ASSISTANT_LLM_MODEL=openai/gpt-oss-20b
ASSISTANT_LLM_API_KEY=

# ── Production only (optional) ──────────────────────────────────────────────
# PM2 worker count (ecosystem.config.cjs). Default: one per CPU core.
PM2_INSTANCES=
# scripts/provision-security.ts: privileged URL used to create the
# low-privilege runtime role APP_DATABASE_USER (default dvs_app) with
# APP_DATABASE_PASSWORD. ADMIN_DATABASE_URL defaults to DATABASE_URL.
ADMIN_DATABASE_URL=
APP_DATABASE_USER=
APP_DATABASE_PASSWORD=

# Live incident events between API processes. Default: shared through
# Postgres LISTEN/NOTIFY under PM2 cluster mode, in memory otherwise.
# "postgres" forces the shared bus; "memory" forces in-process only.
# The listener connects with DIRECT_URL (LISTEN needs a non-pooled connection).
SECURITY_EVENT_BUS=
