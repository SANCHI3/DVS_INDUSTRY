# ── Dependencies ─────────────────────────────────────────────────
node_modules/

# ── Build outputs ─────────────────────────────────────────────────
dist/
build/
.next/
out/

# ── Vite cache ────────────────────────────────────────────────────
.vite/

# ── Environment files (never commit secrets) ──────────────────────
.env
.env.local
.env.*.local

# ── Logs ──────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── TypeScript build info ─────────────────────────────────────────
*.tsbuildinfo

# ── Test coverage ─────────────────────────────────────────────────
coverage/

# ── OS artifacts ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Prisma generated client (regenerated via prisma generate) ─────
generated/prisma/

# ── Root-level lock file (not a workspace root package) ───────────
/package-lock.json

# Perception service: local datasets and generated outputs
perception-service/data/
perception-service/output/

# Python cache and test artifacts
perception-service/__pycache__/
perception-service/**/*.py[cod]
perception-service/.pytest_cache/

# Local logs
perception-service/*.log

# Backup files created during development
perception-service/**/*.before-*

# Local incident data
perception-service/backend/incidents.json
