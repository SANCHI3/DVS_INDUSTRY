# ── Dependencies ─────────────────────────────────────────────────
node_modules/

# ── Build outputs ─────────────────────────────────────────────────
dist/
build/
.next/
out/

# ── Vite cache ────────────────────────────────────────────────────
.vite/

# ── Environment files (never commit secrets) ──────────────────────
.env
.env.local
.env.*.local

# ── Logs ──────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── TypeScript build info ─────────────────────────────────────────
*.tsbuildinfo

# ── Test coverage ─────────────────────────────────────────────────
coverage/

# ── OS artifacts ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Prisma generated client (regenerated via prisma generate) ─────
generated/prisma/

# ── Root-level lock file (not a workspace root package) ───────────
/package-lock.json

# Perception service: local datasets and generated outputs
perception-service/data/
perception-service/output/

# Python cache and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/

# Patches, demo-script logs and local backups
*.patch
*.orig
*.rej
.demo-logs/

# Local logs
perception-service/*.log

# Backup files created during development
perception-service/**/*.before-*

# Local incident data
perception-service/backend/incidents.json

# Model weights (large binaries; distribute separately)
perception-service/**/*.pt
perception-service/models/*.log
# Trained models are committed so the project runs from a fresh clone
# (the two R3D-18 fight models via Git LFS, see .gitattributes)
!perception-service/models/fall_gru_v1.pt
!perception-service/models/fight_r3d18_v1.pt
!perception-service/models/fight_r3d18_v2.pt
!perception-service/models/fire_smoke_yolov8n_v1.pt
!perception-service/yolov8n.pt
!perception-service/yolov8n-pose.pt

# Demo clips come from datasets with varying redistribution terms (see demo_videos/README.md)
perception-service/demo_videos/*
!perception-service/demo_videos/README.md

# Synthetic pose sequences, regenerate with fight_model/make_demo_data.py
perception-service/fight_model/demo_data/

# Zones drawn with scripts/draw_zones.py (copy into cameras.yaml)
perception-service/config/zones_*.yaml
