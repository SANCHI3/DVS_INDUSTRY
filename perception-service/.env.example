# ── Dashboard backend (DVS ERP API) ───────────────────────────────
DASHBOARD_BACKEND_URL=http://127.0.0.1:3000
# Credentials of the PERCEPTION_SERVICE account. Create it by setting
# SEED_PERCEPTION_SERVICE_EMAIL / SEED_PERCEPTION_SERVICE_PASSWORD in
# backend/.env and running `npm run db:seed` there.
DASHBOARD_SERVICE_EMAIL=
DASHBOARD_SERVICE_PASSWORD=
# Optional: a pre-issued access token instead of email/password
DASHBOARD_API_TOKEN=

# ── Optional local incident store (backend/api.py) ────────────────
# Leave LEGACY_INCIDENT_API_URL empty to disable it.
LEGACY_INCIDENT_API_URL=
INCIDENT_API_KEY=

# ── Camera input ──────────────────────────────────────────────────
CCTV_RTSP_URL=
CAMERA_ID=
CAMERA_LOCATION=
CCTV_CONNECT_TIMEOUT_SECONDS=
CCTV_READ_TIMEOUT_SECONDS=
CCTV_RECONNECT_INITIAL_SECONDS=
CCTV_RECONNECT_MAX_SECONDS=
CCTV_RECONNECT_ATTEMPTS=

# ── LLM incident summaries (OpenAI-compatible endpoint) ───────────
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
