# ── Dashboard backend (DVS ERP API) ───────────────────────────────
DASHBOARD_BACKEND_URL=http://127.0.0.1:3000
# The factory PC signs in with this key: CAMERA_SERVICE_KEY on Render.
DASHBOARD_SERVICE_KEY=
# Or the credentials of a PERCEPTION_SERVICE account. Create it by setting
# SEED_PERCEPTION_SERVICE_EMAIL / SEED_PERCEPTION_SERVICE_PASSWORD in
# backend/.env and running `npm run db:seed` there.
DASHBOARD_SERVICE_EMAIL=
DASHBOARD_SERVICE_PASSWORD=
# Optional: a pre-issued access token instead of email/password
DASHBOARD_API_TOKEN=

# ── Optional local incident store (backend/api.py) ────────────────
# Leave LEGACY_INCIDENT_API_URL empty to disable it.
LEGACY_INCIDENT_API_URL=
INCIDENT_API_KEY=

# ── Factory DVR (Hikvision DS-7208HGHI-SH) ────────────────────────
# Through Tailscale: see docs/REMOTE_ACCESS.md. URLs with the password are
# built at runtime and never logged.
DVR_HOST=192.168.0.105
# The address is DHCP: this finds the DVR again if it changes
DVR_MAC=c0:56:e3:1e:10:04
DVR_RTSP_PORT=554
DVR_HTTP_PORT=80
DVR_USERNAME=
DVR_PASSWORD=
# hik_streaming (/Streaming/Channels/101), hik_h264 (/h264/ch1/main/av_stream)
# or dahua for CP PLUS (/cam/realmonitor?channel=1&subtype=0);
# scripts/probe_dvr.py tells you which one works.
DVR_URL_FORMAT=hik_streaming

# ── This monitoring PC ────────────────────────────────────────────
# Name on the website (default: the computer name), e.g. factory-pc / dev-laptop
PERCEPTION_INSTANCE_ID=
# live (default) or dev: dev detections are hidden on the website unless
# "Show test detections" is ticked, and never counted
PERCEPTION_SOURCE=
# true on a laptop over Tailscale: sub stream, <= 1 fps per camera, dev source
REMOTE_MODE=
# Frames per second across all cameras (default 12; 4 with REMOTE_MODE)
MAX_INFER_FPS_TOTAL=
# CPU threads the models may use (default 2)
MODEL_THREADS=
# Live video on the website; the installer sets these
LIVE_VIEW_ENABLED=
LIVE_VIEW_URL=
# Updates download at any hour but install only in this window, India time
AUTO_UPDATE_WINDOW=01:00-05:00
# false switches updates off completely (no checks, no downloads)
AUTO_UPDATE=true
# Disk space for incident pictures waiting to upload (default 500)
EVIDENCE_QUEUE_MAX_MB=

# ── Camera input ──────────────────────────────────────────────────
CCTV_RTSP_URL=
CAMERA_ID=
CAMERA_LOCATION=
CCTV_CONNECT_TIMEOUT_SECONDS=
CCTV_READ_TIMEOUT_SECONDS=
CCTV_RECONNECT_INITIAL_SECONDS=
CCTV_RECONNECT_MAX_SECONDS=
CCTV_RECONNECT_ATTEMPTS=

# ── LLM incident summaries (OpenAI-compatible endpoint) ───────────
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
