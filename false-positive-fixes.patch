+    rng = np.random.default_rng(4)
+    frames, boxes = [], []
+    for i in range(200):
+        frame = _room(rng)
+        if i >= 100:
+            r = 10 + (i - 100) // 2
+            cv2.circle(frame, (160, 90), r, (170, 170, 170), -1)
+            boxes.append((160 - r, 90 - r, 160 + r, 90 + r))
