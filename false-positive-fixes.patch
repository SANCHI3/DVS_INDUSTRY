+    frames = [np.clip(f.astype(np.float32) * (0.7 + 0.005 * i), 0, 255).astype(np.uint8)
+              for i, f in enumerate(base)]
+    _, out = _run_fire(frames, lambda i: [(0, 0.7, BOX), (1, 0.6, (0, 0, 320, 120))])
+    assert not out, out
