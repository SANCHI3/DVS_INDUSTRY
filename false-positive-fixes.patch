+                                   size_jitter=25.0, seed=3)
+    out = _feed_rgb(detector, fight)
+    assert out and out[0].event_type == "fight"
+    assert abs(out[0].raw_confidence - 0.9) < 1e-9 and out[0].detail["interaction"]["agitated"]
