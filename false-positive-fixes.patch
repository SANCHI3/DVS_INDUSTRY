+    calm = lambda n: _pair_buffer(lambda t: [(1, 300), (2, 380)], seconds=n * DT, jitter=2.0, size_jitter=2.0)
+    assert not _feed_rgb(detector, calm)
+    assert detector.diagnostics()["rejected_no_interaction"] > 0
