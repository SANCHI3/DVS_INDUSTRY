+        x = (i * 7) % 280
+        cv2.rectangle(frame, (x, 170), (x + 30, 235), (200, 200, 230), -1)  # below the object
+        frames.append(frame)
+    _, out = _run_fire(frames, lambda i: [(0, 0.75, BOX)])
+    assert not out
