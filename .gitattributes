# Keep LF line endings in the working tree on every OS. Prettier/ESLint expect
# LF; Windows checkouts with core.autocrlf=true would otherwise get CRLF.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.pt binary
*.pkl binary
*.npz binary
*.npy binary
*.mp4 binary
